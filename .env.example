# ==============================================================================
# RockWatch Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: LiteLLM Local Proxy (Recommended for pooling many API keys)
# Run LiteLLM on your laptop: litellm --config litellm_config.yaml --port 4000
# ------------------------------------------------------------------------------
LITELLM_API_BASE="http://localhost:4000/v1"
LITELLM_API_KEY="sk-litellm-local"

# ------------------------------------------------------------------------------
# Target Model (default: gemini-3.5-flash-lite)
# ------------------------------------------------------------------------------
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# Option 2: Direct Multi-Key Pool (Built-in round-robin rotation & 429 failover)
# List any number of API keys here separated by commas (the example uses 11):
# ------------------------------------------------------------------------------
GEMINI_API_KEYS="key1,key2,key3,key4,key5,key6,key7,key8,key9,key10,key11"

# Optional single Gemini API key, appended to the pool if distinct:
GEMINI_API_KEY=""

# Request Timeout (seconds)
LLM_TIMEOUT_SECONDS=6.0

# ------------------------------------------------------------------------------
# Geotechnical Authorization (REQUIRED for sensitivity attenuation)
# ------------------------------------------------------------------------------
# HMAC key used to sign short-lived engineer credentials. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ROCKWATCH_AUTH_SECRET=""

# SHA-256 digest of the pit authorization passphrase. Generate with:
#   python -c "import hashlib; print(hashlib.sha256(b'your-passphrase').hexdigest())"
ROCKWATCH_GEOTECH_PASSPHRASE_SHA256=""
