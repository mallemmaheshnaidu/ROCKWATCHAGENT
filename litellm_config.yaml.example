      api_key: "YOUR_GEMINI_API_KEY_8"
      rpm: 15

  # Key 9
  - model_name: gemini-3.5-flash-light
    litellm_params:
      model: gemini/gemini-3.5-flash-light
      api_key: "YOUR_GEMINI_API_KEY_9"
      rpm: 15

  # Key 10
  - model_name: gemini-3.5-flash-light
    litellm_params:
      model: gemini/gemini-3.5-flash-light
      api_key: "YOUR_GEMINI_API_KEY_10"
