      model: gemini/gemini-3.5-flash-light
      api_key: "YOUR_GEMINI_API_KEY_11"
      rpm: 15

router_settings:
  routing_strategy: "usage-based-routing"
  num_retries: 3
  timeout: 10
  allowed_fails: 2
  cooldown_time: 60

general_settings:
  master_key: "sk-litellm-local"
