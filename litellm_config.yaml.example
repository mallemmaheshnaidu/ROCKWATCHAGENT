# ==============================================================================
# LiteLLM Proxy Configuration for RockWatch Multi-Agent System
# ==============================================================================
# Run this proxy on your laptop using:
#   litellm --config litellm_config.yaml --port 4000
#
# This pools your 11 Gemini API keys to achieve:
#   - Total Rate Limit: 165 Requests Per Minute (11 keys x 15 RPM)
#   - Total Daily Capacity: 5,500 Requests/Day (11 keys x 500 requests/day)
#   - Automatic Load Balancing across all 11 keys
#   - Automatic Cooldown and Failover on HTTP 429
# ==============================================================================

model_list:
  # Key 1
  - model_name: gemini-3.5-flash-light
    litellm_params:
      model: gemini/gemini-3.5-flash-light
      api_key: "YOUR_GEMINI_API_KEY_1"
      rpm: 15

  # Key 2
  - model_name: gemini-3.5-flash-light
    litellm_params:
      model: gemini/gemini-3.5-flash-light
      api_key: "YOUR_GEMINI_API_KEY_2"
      rpm: 15

